{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "release-type": "node",
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "group-pull-request-title-pattern": "chore${scope}: release visual-check libraries",
  "packages": {
    "packages/cli": { "component": "cli", "initial-version": "0.1.0" },
    "packages/storybook": { "component": "storybook", "initial-version": "0.1.0" },
    "packages/storybook-addon": { "component": "storybook-addon", "initial-version": "0.1.0" }
  },
  "plugins": [
    { "type": "linked-versions", "groupName": "visual-check", "components": ["cli", "storybook", "storybook-addon"] }
  ]
}
