{
  "name": "visual-check-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "build": "turbo run build",
    "check:lockstep": "node packages/repo-checks/src/check-lockstep.ts",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "turbo run lint:biome lint:fallow",
    "lint:biome": "biome check .",
    "lint:fallow": "fallow --fail-on-issues --format compact",
    "prepare": "lefthook install",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "fallow": "3.42.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.11"
  }
}
