{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "domains": {
      "turborepo": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noPrivateImports": { "level": "error", "options": { "defaultVisibility": "package" } }
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "suspicious": {
        "noUndeclaredEnvVars": {
          "level": "on",
          "options": { "allowedEnvVars": ["SystemRoot", "VISUAL_CHECK_STORYBOOK"] }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "pixelmatch": "Only packages/cli/src/visual-diff/ compares images, through pixelmatch.",
              "sharp": "Only packages/cli/src/visual-diff/ decodes and encodes images, through sharp.",
              "yauzl": "Only packages/cli/src/browser-download/ unzips, through yauzl."
            }
          }
        },
        "useBlockStatements": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"], "requireAscii": true, "strictCase": true }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "test-storybooks/*/visual-check.config.ts",
        "test-storybooks/storybook-10-react/.storybook/visual-check.ts",
        "test-storybooks/storybook-10-react/stories/grid.stories.tsx",
        "test-storybooks/storybook-10-react/stories/forced-states.stories.tsx",
        "test-storybooks/storybook-10-react/e2e.ts",
        "test-storybooks/storybook-10-react/e2e-support.ts",
        "test-storybooks/storybook-10-react/addon-e2e.ts"
      ],
      "linter": {
        "rules": {
          "correctness": { "noPrivateImports": "off" }
        }
      }
    },
    {
      "includes": ["packages/cli/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pixelmatch": "Only packages/cli/src/visual-diff/ compares images, through pixelmatch.",
                  "sharp": "Only packages/cli/src/visual-diff/ decodes and encodes images, through sharp.",
                  "yauzl": "Only packages/cli/src/browser-download/ unzips, through yauzl.",
                  "ink": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React.",
                  "ink-testing-library": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React.",
                  "react": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React."
                },
                "patterns": [
                  {
                    "group": ["ink/**", "ink-testing-library/**", "react/**"],
                    "message": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/src/browser-download/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pixelmatch": "Only packages/cli/src/visual-diff/ compares images, through pixelmatch.",
                  "sharp": "Only packages/cli/src/visual-diff/ decodes and encodes images, through sharp.",
                  "ink": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React.",
                  "ink-testing-library": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React.",
                  "react": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React."
                },
                "patterns": [
                  {
                    "group": ["ink/**", "ink-testing-library/**", "react/**"],
                    "message": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/src/terminal-ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pixelmatch": "Only packages/cli/src/visual-diff/ compares images, through pixelmatch.",
                  "sharp": "Only packages/cli/src/visual-diff/ decodes and encodes images, through sharp.",
                  "yauzl": "Only packages/cli/src/browser-download/ unzips, through yauzl."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/src/visual-diff/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "yauzl": "Only packages/cli/src/browser-download/ unzips, through yauzl.",
                  "ink": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React.",
                  "ink-testing-library": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React.",
                  "react": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React."
                },
                "patterns": [
                  {
                    "group": ["ink/**", "ink-testing-library/**", "react/**"],
                    "message": "Only packages/cli/src/terminal-ui/ draws the terminal UI, through Ink and React."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/storybook-addon/**"],
      "javascript": { "jsxRuntime": "reactClassic" },
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pixelmatch": "Only packages/cli/src/visual-diff/ compares images, through pixelmatch.",
                  "sharp": "Only packages/cli/src/visual-diff/ decodes and encodes images, through sharp.",
                  "yauzl": "Only packages/cli/src/browser-download/ unzips, through yauzl.",
                  "storybook/manager-api": {
                    "importNames": [
                      "experimental_UniversalStore",
                      "experimental_useUniversalStore",
                      "experimental_MockUniversalStore",
                      "internal_universalStatusStore",
                      "internal_universalTestProviderStore",
                      "internal_universalChecklistStore"
                    ],
                    "message": "The addon never uses UniversalStore, which Storybook 11 makes internal."
                  },
                  "storybook/internal/core-server": {
                    "importNames": [
                      "experimental_UniversalStore",
                      "experimental_useUniversalStore",
                      "experimental_MockUniversalStore",
                      "internal_universalStatusStore",
                      "internal_universalTestProviderStore",
                      "internal_universalChecklistStore"
                    ],
                    "message": "The addon never uses UniversalStore, which Storybook 11 makes internal."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/storybook/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pixelmatch": "Only packages/cli/src/visual-diff/ compares images, through pixelmatch.",
                  "sharp": "Only packages/cli/src/visual-diff/ decodes and encodes images, through sharp.",
                  "yauzl": "Only packages/cli/src/browser-download/ unzips, through yauzl.",
                  "react": "Only packages/storybook/src/react-port/ draws the grid with React.",
                  "react-dom": "Only packages/storybook/src/react-port/ draws the grid with React."
                },
                "patterns": [
                  {
                    "group": ["react/**", "react-dom/**"],
                    "message": "Only packages/storybook/src/react-port/ draws the grid with React."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/storybook/src/react-port/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pixelmatch": "Only packages/cli/src/visual-diff/ compares images, through pixelmatch.",
                  "sharp": "Only packages/cli/src/visual-diff/ decodes and encodes images, through sharp.",
                  "yauzl": "Only packages/cli/src/browser-download/ unzips, through yauzl."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/skill/SKILL.md"],
      "formatter": { "enabled": false }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
