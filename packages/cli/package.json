{
  "name": "@visual-check/cli",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "bin": {
    "visual-check": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "files": [
    "dist",
    "fallow-graph.json",
    "skill"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/addon-build": {
      "types": "./dist/addon-build.d.ts",
      "default": "./dist/addon-build.js"
    },
    "./internal/addon-child": "./dist/addon-child.js",
    "./internal/addon-protocol": {
      "types": "./dist/addon-child/protocol.d.ts",
      "default": "./dist/addon-child/protocol.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "fallow": "3.42.0",
    "ink": "^8.0.0",
    "jiti": "^2.7.0",
    "pixelmatch": "^8.0.0",
    "react": "^19.3.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  },
  "peerDependencies": {
    "@visual-check/chromium": "^157.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@visual-check/chromium": "workspace:*",
    "@visual-check/typescript-config": "workspace:*",
    "ink-testing-library": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
