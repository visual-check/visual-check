{
  "$schema": "./node_modules/fallow/schema.json",
  "supportEntry": [
    "test-storybooks/storybook-9-react/visual-check.config.ts",
    "test-storybooks/storybook-10-react/visual-check.config.ts",
    "test-storybooks/storybook-11-react/visual-check.config.ts"
  ],
  "ignorePatterns": ["test-storybooks/storybook-10-react/static/**", "test-storybooks/setup/fixtures/**"],
  "workspaces": {
    "settings": {
      "test-storybooks/storybook-9-react": { "ignoreDependencies": ["@visual-check/storybook"] },
      "test-storybooks/storybook-11-react": { "ignoreDependencies": ["@visual-check/storybook"] },
      "test-storybooks/setup": {
        "ignoreDependencies": [
          "@visual-check/chromium",
          "@visual-check/cli",
          "@visual-check/storybook",
          "@visual-check/storybook-addon"
        ]
      }
    }
  },
  "duplicates": {
    "minOccurrences": 2
  },
  "rules": {
    "unused-dependencies": "warn",
    "boundary-violation": "error"
  },
  "boundaries": {
    "zones": [
      { "name": "cli/capture/driver/cdp", "patterns": ["packages/cli/src/capture/driver/cdp/**"] },
      { "name": "cli/capture/driver", "patterns": ["packages/cli/src/capture/driver/**"] },
      { "name": "cli/capture", "patterns": ["packages/cli/src/capture/**"] },
      { "name": "cli/container", "patterns": ["packages/cli/src/container/**"] },
      { "name": "cli/browser-process", "patterns": ["packages/cli/src/browser-process/**"] },
      { "name": "cli/baselines", "patterns": ["packages/cli/src/baselines/**"] },
      { "name": "cli/browser", "patterns": ["packages/cli/src/browser/**"] },
      { "name": "cli/browser-download", "patterns": ["packages/cli/src/browser-download/**"] },
      { "name": "cli/commands", "patterns": ["packages/cli/src/commands/**"] },
      { "name": "cli/config", "patterns": ["packages/cli/src/config/**"] },
      { "name": "cli/docs-site", "patterns": ["packages/cli/src/docs-site/**"] },
      { "name": "cli/init", "patterns": ["packages/cli/src/init/**"] },
      { "name": "cli/report", "patterns": ["packages/cli/src/report/**"] },
      { "name": "cli/reporter", "patterns": ["packages/cli/src/reporter/**"] },
      { "name": "cli/sharding", "patterns": ["packages/cli/src/sharding/**"] },
      { "name": "cli/storybook", "patterns": ["packages/cli/src/storybook/**"] },
      { "name": "cli/system-error", "patterns": ["packages/cli/src/system-error/**"] },
      { "name": "cli/terminal-ui", "patterns": ["packages/cli/src/terminal-ui/**"] },
      { "name": "cli/visual-diff", "patterns": ["packages/cli/src/visual-diff/**"] },
      { "name": "storybook/per-story-options", "patterns": ["packages/storybook/src/per-story-options/**"] },
      { "name": "repo-checks/workspace", "patterns": ["packages/repo-checks/src/workspace/**"] },
      { "name": "repo-checks/lockstep", "patterns": ["packages/repo-checks/src/lockstep/**"] },
      { "name": "repo-checks/chromium-checksums", "patterns": ["packages/repo-checks/src/chromium-checksums/**"] },
      { "name": "repo-checks/no-playwright", "patterns": ["packages/repo-checks/src/no-playwright/**"] },
      { "name": "repo-checks/source-layout", "patterns": ["packages/repo-checks/src/source-layout/**"] }
    ],
    "rules": [
      { "from": "cli/capture/driver/cdp", "allow": ["cli/capture/driver"] },
      { "from": "cli/capture/driver", "allow": [] },
      { "from": "cli/capture", "allow": ["cli/capture/driver", "cli/storybook"] },
      { "from": "cli/container", "allow": ["cli/capture/driver"] },
      { "from": "cli/browser-process", "allow": ["cli/capture/driver"] },
      { "from": "cli/baselines", "allow": ["cli/system-error"] },
      { "from": "cli/browser", "allow": ["cli/config"] },
      { "from": "cli/browser-download", "allow": [] },
      {
        "from": "cli/commands",
        "allow": [
          "cli/baselines",
          "cli/browser",
          "cli/browser-download",
          "cli/browser-process",
          "cli/capture",
          "cli/capture/driver",
          "cli/capture/driver/cdp",
          "cli/config",
          "cli/container",
          "cli/docs-site",
          "cli/init",
          "cli/report",
          "cli/reporter",
          "cli/sharding",
          "cli/storybook",
          "cli/terminal-ui",
          "cli/visual-diff"
        ]
      },
      { "from": "cli/config", "allow": [] },
      { "from": "cli/docs-site", "allow": [] },
      {
        "from": "cli/init",
        "allow": ["cli/baselines", "cli/config", "cli/container", "cli/docs-site", "cli/storybook"]
      },
      { "from": "cli/report", "allow": ["cli/system-error"] },
      { "from": "cli/reporter", "allow": ["cli/report"] },
      { "from": "cli/sharding", "allow": ["cli/baselines", "cli/storybook"] },
      { "from": "cli/storybook", "allow": [] },
      { "from": "cli/system-error", "allow": [] },
      { "from": "cli/terminal-ui", "allow": ["cli/init"] },
      { "from": "cli/visual-diff", "allow": ["cli/config"] },
      { "from": "storybook/per-story-options", "allow": [] },
      { "from": "repo-checks/workspace", "allow": [] },
      { "from": "repo-checks/lockstep", "allow": ["repo-checks/workspace"] },
      { "from": "repo-checks/chromium-checksums", "allow": ["repo-checks/workspace"] },
      { "from": "repo-checks/no-playwright", "allow": ["repo-checks/workspace"] },
      { "from": "repo-checks/source-layout", "allow": ["repo-checks/workspace"] }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "packages/cli/src/bin.ts",
        "packages/cli/src/index.ts",
        "packages/storybook/src/index.ts",
        "packages/storybook-addon/src/manager.ts",
        "packages/storybook-addon/src/preset.ts",
        "packages/repo-checks/src/check-chromium-checksums.ts",
        "packages/repo-checks/src/check-lockstep.ts",
        "test-storybooks/storybook-9-react/.storybook/main.ts",
        "test-storybooks/storybook-9-react/visual-check.config.ts",
        "test-storybooks/storybook-10-react/.storybook/main.ts",
        "test-storybooks/storybook-10-react/.storybook/test-storybook-config.ts",
        "test-storybooks/storybook-10-react/.storybook/shared-preview.ts",
        "test-storybooks/storybook-10-react/.storybook/visual-check.ts",
        "test-storybooks/storybook-10-react/stories/*.stories.tsx",
        "test-storybooks/storybook-10-react/stories/mocking-worker.ts",
        "test-storybooks/storybook-10-react/stories/remote-origin.ts",
        "test-storybooks/storybook-10-react/e2e.ts",
        "test-storybooks/storybook-10-react/visual-check.config.ts",
        "test-storybooks/storybook-11-react/.storybook/main.ts",
        "test-storybooks/storybook-11-react/visual-check.config.ts",
        "test-storybooks/setup/*.ts",
        "packages/*/test/**/*.test.ts"
      ]
    }
  }
}
